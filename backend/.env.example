# Puerto del servidor API
PORT=4000

# URL de la base de datos SQLite.
# En Prisma 7 (con prisma.config.ts) la ruta `file:` es relativa al directorio
# de trabajo del backend (donde se ejecutan los comandos npm), por lo que la
# base queda en backend/dev.db.
DATABASE_URL="file:./dev.db"

# Origenes permitidos por CORS (separados por comas). En desarrollo: el dev server de Vite.
CORS_ORIGIN="http://localhost:5173"

# Entorno: development | production
NODE_ENV=development

# Saltos de proxy de confianza para rate-limit/CORS (trust proxy).
# 0 = acceso directo (dev). 1 = tras un proxy reverso (producción).
TRUST_PROXY=0

# Lista blanca de orígenes para el endpoint de reservas (misma regla que CORS).
# Comentario: en producción este proyecto queda tras un proxy; aquí solo se usa en desarrollo.

# Secreto para firmar los tokens de sesión del panel administrativo.
# En producción debe ser una cadena larga y aleatoria.
AUTH_SECRET="cambia-este-secreto-en-produccion-minimo-32-caracteres"

# Vigencia del token de sesión en segundos (8 horas por defecto).
AUTH_TOKEN_TTL_SECONDS=28800

# Credenciales del usuario administrador inicial creado por el seed.
ADMIN_EMAIL="admin@sonrisadental.cl"
ADMIN_PASSWORD="admin-1234"